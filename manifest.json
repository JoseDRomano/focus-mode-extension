{
  "manifest_version": 3,
  "name": "Focus Mode",
  "version": "2.0.0",
  "description": "Blocks distracting sites during your work hours and cleans up the feeds the rest of the time.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "css": ["src/content/youtube.css"],
      "js": ["src/content/cleanup.js", "src/content/youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.linkedin.com/*"],
      "css": ["src/content/linkedin.css"],
      "js": ["src/content/cleanup.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://x.com/*", "*://twitter.com/*"],
      "css": ["src/content/x.css"],
      "js": ["src/content/cleanup.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.reddit.com/*"],
      "css": ["src/content/reddit.css"],
      "js": ["src/content/cleanup.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.instagram.com/*"],
      "css": ["src/content/instagram.css"],
      "js": ["src/content/cleanup.js", "src/content/instagram.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Focus Mode",
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["src/pages/blocked.html"],
      "matches": ["*://*/*"]
    },
    {
      "resources": ["src/shared/settings.js"],
      "matches": [
        "*://www.youtube.com/*",
        "*://www.linkedin.com/*",
        "*://x.com/*",
        "*://twitter.com/*",
        "*://www.reddit.com/*",
        "*://www.instagram.com/*"
      ]
    }
  ]
}
